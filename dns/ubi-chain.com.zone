www              3600   IN CNAME  cname.vercel-dns.com.
pay              3600   IN CNAME  cname.vercel-dns.com.
news             3600   IN CNAME  cname.vercel-dns.com.
international    3600   IN CNAME  cname.vercel-dns.com.
ai               3600   IN CNAME  cname.vercel-dns.com.
infra            3600   IN CNAME  cname.vercel-dns.com.
monitor          3600   IN CNAME  cname.vercel-dns.com.
